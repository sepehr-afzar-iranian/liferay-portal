<?xml version="1.0"?>
<!DOCTYPE liferay-social PUBLIC "-//Liferay//DTD Social 7.3.0//EN" "https://raw.githubusercontent.com/sepehr-afzar-iranian/liferay-dtd/refs/heads/main/liferay-social_7_3_0.dtd">

<liferay-social>
	<activity>
		<model-name>com.liferay.calendar.model.CalendarBooking</model-name>
		<activity-type>${com.liferay.social.kernel.model.SocialActivityConstants.TYPE_MOVE_TO_TRASH}</activity-type>
		<log-activity>true</log-activity>
		<counters-enabled>false</counters-enabled>
	</activity>
	<activity>
		<model-name>com.liferay.calendar.model.CalendarBooking</model-name>
		<activity-type>${com.liferay.social.kernel.model.SocialActivityConstants.TYPE_RESTORE_FROM_TRASH}</activity-type>
		<log-activity>true</log-activity>
		<counters-enabled>false</counters-enabled>
	</activity>
</liferay-social>